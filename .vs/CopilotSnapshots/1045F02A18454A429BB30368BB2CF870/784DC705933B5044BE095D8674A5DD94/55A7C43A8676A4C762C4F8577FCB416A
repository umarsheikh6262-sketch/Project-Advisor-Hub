        private readonly string connectionString = @"Data Source=DESKTOP-16T00M6\SQLEXPRESS01;Initial Catalog=ProjectAdvisorHub;Integrated Security=True;";
        private Chart dashboardChart;

        public Form4()
        {
            InitializeComponent();
