    public static class SecureHelper
    {
        public static string ComputeMD5(string rawText)
        {
            using (System.Security.Cryptography.MD5 md5 = System.Security.Cryptography.MD5.Create())
            {
                byte[] byteInput = System.Text.Encoding.ASCII.GetBytes(rawText);
                byte[] byteHash = md5.ComputeHash(byteInput);
                System.Text.StringBuilder build = new System.Text.StringBuilder();
                for (int i = 0; i < byteHash.Length; i++) build.Append(byteHash[i].ToString("X2"));
                return build.ToString().ToLower();
            }
        }
    }
