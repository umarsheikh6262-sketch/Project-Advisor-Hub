        private void lvGroups_DragDrop(object sender, DragEventArgs e)
        {
            if (e.Data.GetDataPresent(typeof(ListViewItem)))
            {
                ListViewItem movedStudent = (ListViewItem)e.Data.GetData(typeof(ListViewItem));
                System.Drawing.Point pos = lvGroups.PointToClient(new System.Drawing.Point(e.X, e.Y));
                ListViewItem targetedGroup = lvGroups.GetItemAt(pos.X, pos.Y);

                if (targetedGroup != null && targetedGroup.Tag != null)
                {
                    int groupId = (int)targetedGroup.Tag;
                    int studentId = (int)movedStudent.Tag;

                    using (SqlConnection conn = new SqlConnection(connString))
                    {
                        SqlCommand cmd = new SqlCommand("UPDATE Students SET GroupID = @GID WHERE StudentID = @SID", conn);
                        cmd.Parameters.AddWithValue("@GID", groupId);
                        cmd.Parameters.AddWithValue("@SID", studentId);
                        try
                        {
                            conn.Open();
                            cmd.ExecuteNonQuery();
                            LoadGroupManagementSection();
                        }
                        catch (Exception ex)
                        {
                            MessageBox.Show("Relational structural updates aborted on node relocation: " + ex.Message);
                        }
                    }
                }
            }
        }
