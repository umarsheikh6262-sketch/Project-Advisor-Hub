        #region Dropdown & Allocation Processing Pipeline
        private void LoadAllocationDropdowns()
        {
            cmbGroupsForProject.Items.Clear();
            cmbGroupsForAdvisors.Items.Clear();
            cmbProjects.Items.Clear();
            lbAdvisors.Items.Clear();

            using (SqlConnection conn = new SqlConnection(connString))
            {
                try
                {
                    conn.Open();

                    // Load Group Entities
                    SqlCommand cmd = new SqlCommand("SELECT GroupID, GroupName FROM Groups", conn);
                    SqlDataAdapter adapter = new SqlDataAdapter(cmd);
                    DataTable dtG = new DataTable();
                    adapter.Fill(dtG);

                    foreach (DataRow r in dtG.Rows)
                    {
                        ComboBoxItem item = new ComboBoxItem { Text = r["GroupName"].ToString(), Value = r["GroupID"] };
                        cmbGroupsForProject.Items.Add(item);
                        cmbGroupsForAdvisors.Items.Add(item);
                    }

                    // Load Project Inventory Pools
                    SqlCommand cmdP = new SqlCommand("SELECT ProjectID, Title FROM Projects", conn);
                    DataTable dtP = new DataTable();
                    new SqlDataAdapter(cmdP).Fill(dtP);
                    foreach (DataRow r in dtP.Rows)
                    {
                        cmbProjects.Items.Add(new ComboBoxItem { Text = r["Title"].ToString(), Value = r["ProjectID"] });
                    }

                    // Load Multi-Select Advisor Pools
                    SqlCommand cmdA = new SqlCommand("SELECT AdvisorID, FullName FROM Advisors", conn);
                    DataTable dtA = new DataTable();
                    new SqlDataAdapter(cmdA).Fill(dtA);
                    foreach (DataRow r in dtA.Rows)
                    {
                        lbAdvisors.Items.Add(new ComboBoxItem { Text = r["FullName"].ToString(), Value = r["AdvisorID"] });
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Dropdown reference population failed: " + ex.Message);
                }
            }
        }

        private void btnAssignProject_Click(object sender, EventArgs e)
        {
            if (cmbGroupsForProject.SelectedItem == null || cmbProjects.SelectedItem == null) return;

            int gId = (int)((ComboBoxItem)cmbGroupsForProject.SelectedItem).Value;
            int pId = (int)((ComboBoxItem)cmbProjects.SelectedItem).Value;

            using (SqlConnection conn = new SqlConnection(connString))
            {
                // Verify matching assignment metrics or update placeholder state
                SqlCommand cmd = new SqlCommand(@"
                    IF EXISTS (SELECT 1 FROM ProjectAssignments WHERE GroupID = @GID)
                        UPDATE ProjectAssignments SET ProjectID = @PID WHERE GroupID = @GID;
                    ELSE
                        INSERT INTO ProjectAssignments (GroupID, ProjectID, AdvisorID) VALUES (@GID, @PID, (SELECT TOP 1 AdvisorID FROM Advisors));", conn);

                cmd.Parameters.AddWithValue("@GID", gId);
                cmd.Parameters.AddWithValue("@PID", pId);
                try
                {
                    conn.Open();
                    cmd.ExecuteNonQuery();
                    MessageBox.Show("Project mapped successfully to selection target structural framework.", "Allocation Context Stabilized");
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Failure recording allocation parameters: " + ex.Message);
                }
            }
        }

        private void btnAssignAdvisors_Click(object sender, EventArgs e)
        {
            if (cmbGroupsForAdvisors.SelectedItem == null || lbAdvisors.SelectedItems.Count == 0) return;

            int gId = (int)((ComboBoxItem)cmbGroupsForAdvisors.SelectedItem).Value;

            using (SqlConnection conn = new SqlConnection(connString))
            {
                try
                {
                    conn.Open();
                    // Multi-assignment configuration logic maps multiple entries sequentially
                    foreach (ComboBoxItem activeAdvisor in lbAdvisors.SelectedItems)
                    {
                        int aId = (int)activeAdvisor.Value;
                        SqlCommand cmd = new SqlCommand(@"
                            IF NOT EXISTS(SELECT 1 FROM ProjectAssignments WHERE GroupID = @GID AND AdvisorID = @AID)
                                INSERT INTO ProjectAssignments (GroupID, ProjectID, AdvisorID) VALUES (@GID, (SELECT TOP 1 ProjectID FROM Projects), @AID);", conn);
                        cmd.Parameters.AddWithValue("@GID", gId);
                        cmd.Parameters.AddWithValue("@AID", aId);
                        cmd.ExecuteNonQuery();
                    }
                    MessageBox.Show("Multi-advisor linkages bounded safely to target structural assembly.", "Roster Updates Stabilized");
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Relational junction generation fault checking multi-assignment sets: " + ex.Message);
                }
            }
        }
