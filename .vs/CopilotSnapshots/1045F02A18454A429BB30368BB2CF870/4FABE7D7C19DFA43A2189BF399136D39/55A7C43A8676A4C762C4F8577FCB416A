        #region Inline CRUD Execution Logic (Students & Advisors Grid UI Mapping)
        private void InitializeDataManagement()
        {
            using (SqlConnection conn = new SqlConnection(connString))
            {
                // Initialize mapping data tables 
                studentTable = new DataTable();
                studentAdapter = new SqlDataAdapter("SELECT s.StudentID, s.FullName, s.RollNumber, u.Email FROM Students s JOIN Users u ON s.UserID = u.UserID", conn);
                studentAdapter.Fill(studentTable);
                dgvStudents.DataSource = studentTable;
                if (dgvStudents.Columns.Contains("StudentID")) dgvStudents.Columns["StudentID"].ReadOnly = true;

                advisorTable = new DataTable();
                advisorAdapter = new SqlDataAdapter("SELECT a.AdvisorID, a.FullName, a.Department, u.Email FROM Advisors a JOIN Users u ON a.UserID = u.UserID", conn);
                advisorAdapter.Fill(advisorTable);
                dgvAdvisors.DataSource = advisorTable;
                if (dgvAdvisors.Columns.Contains("AdvisorID")) dgvAdvisors.Columns["AdvisorID"].ReadOnly = true;
            }
        }

