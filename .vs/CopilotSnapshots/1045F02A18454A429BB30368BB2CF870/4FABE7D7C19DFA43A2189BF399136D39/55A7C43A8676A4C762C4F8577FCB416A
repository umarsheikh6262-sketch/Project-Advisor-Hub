        #region ListView-Based Drag and Drop Group Assembly Execution
        private void LoadGroupManagementSection()
        {
            lvGroups.Clear();
            lvGroups.Columns.Add("Active Managed System Groups", 380);

            lvUnassignedStudents.Clear();

            using (SqlConnection conn = new SqlConnection(connString))
            {
                try
                {
                    conn.Open();

                    // Fetch existing structures
                    SqlCommand cmdG = new SqlCommand("SELECT GroupID, GroupName FROM Groups", conn);
                    SqlDataReader rdrG = cmdG.ExecuteReader();
                    while (rdrG.Read())
                    {
                        ListViewItem groupItem = new ListViewItem(rdrG["GroupName"].ToString())
                        {
                            Tag = rdrG["GroupID"],
                            BackColor = System.Drawing.Color.LightGray
                        };
                        lvGroups.Items.Add(groupItem);
                    }
                    rdrG.Close();

                    // Fetch loose nodes (unassigned students)
                    SqlCommand cmdS = new SqlCommand("SELECT StudentID, FullName FROM Students WHERE GroupID IS NULL", conn);
                    SqlDataReader rdrS = cmdS.ExecuteReader();
                    while (rdrS.Read())
                    {
                        ListViewItem studentItem = new ListViewItem(rdrS["FullName"].ToString())
                        {
                            Tag = rdrS["StudentID"]
                        };
                        lvUnassignedStudents.Items.Add(studentItem);
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Group infrastructure resolution aborted: " + ex.Message);
                }
            }
        }

