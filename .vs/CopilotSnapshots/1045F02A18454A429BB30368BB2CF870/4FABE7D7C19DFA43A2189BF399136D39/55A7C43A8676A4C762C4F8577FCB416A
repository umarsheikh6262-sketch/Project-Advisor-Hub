        #region Home Tab Metrics Chart
        private void LoadDashboardMetrics()
        {
            chartDistribution.Series.Clear();
            chartDistribution.ChartAreas.Clear();

            ChartArea area = new ChartArea("MainArea");
            chartDistribution.ChartAreas.Add(area);

            Series pieSeries = new Series("Distribution")
            {
                ChartType = SeriesChartType.Pie,
                IsValueShownAsLabel = true
            };

            using (SqlConnection conn = new SqlConnection(connString))
            {
                string commandText = @"
                    SELECT 'Students' AS Label, COUNT(*) AS Total FROM Students
                    UNION ALL
                    SELECT 'Advisors' AS Label, COUNT(*) AS Total FROM Advisors
                    UNION ALL
                    SELECT 'Active Groups' AS Label, COUNT(*) AS Total FROM Groups;";

                SqlCommand cmd = new SqlCommand(commandText, conn);
                try
                {
                    conn.Open();
                    SqlDataReader reader = cmd.ExecuteReader();
                    while (reader.Read())
                    {
                        int total = Convert.ToInt32(reader["Total"]);
                        string label = reader["Label"].ToString();
                        pieSeries.Points.AddXY($"{label} ({total})", total);
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Error initializing charts metrics visualization: " + ex.Message);
                }
            }

            chartDistribution.Series.Add(pieSeries);
        }
